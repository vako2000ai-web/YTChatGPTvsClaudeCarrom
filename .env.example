# demo never sends requests. api requires both keys and model IDs.
MODE=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Exact IDs supported by your accounts, with structured JSON output support.
OPENAI_MODEL=
ANTHROPIC_MODEL=
API_TIMEOUT=25
API_MAX_OUTPUT_TOKENS=1024
# OBS Studio WebSocket v5. Password is local-only and never bundled.
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Original local SFX. Volumes 0..1; M / minus / plus in GUI.
AUDIO_ENABLED=true
AUDIO_MASTER_VOLUME=0.75
AUDIO_SFX_VOLUME=0.8
AUDIO_MUSIC_VOLUME=0
AUDIO_VOICE_VOLUME=0.85
# Opt-in paid TTS; distinct allowed voices, key only in your local .env.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_1=
ELEVENLABS_VOICE_ID_2=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Conservative caps shared across launches in matches/.voice-cache/budget.sqlite3.
# Set a positive rate for your own plan before enabling. Vendor invoice is final.
ELEVENLABS_MAX_CHARACTERS=2000
ELEVENLABS_MAX_ESTIMATED_USD=1
ELEVENLABS_USD_PER_1000_CHARACTERS=0
